# VisionGuide Multi-Agent Configuration
# Copy this file to .env in the root or backend/ directory

# OpenAI API Key for Voice Agent (Whisper-1 Speech-to-Text & Intent Parsing)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key for Vision Agent (gemini-2.5-flash Multimodal Scene Understanding)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key for Navigation Agent (Walking Directions & Places API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# YOLOv8 Model Path (auto-downloads yolov8n.pt on first run if not present)
YOLO_MODEL_PATH=yolov8n.pt

# EasyOCR GPU Acceleration (set to true if CUDA GPU is available)
EASYOCR_GPU=false

# SQLite Database Path
VISIONGUIDE_DB_PATH=visionguide.db

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Frontend Backend URL (used by Expo app)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000

